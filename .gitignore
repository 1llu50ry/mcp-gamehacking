# Upstream repo mirror for development — contents land under tools/vendor/
# via the vendoring process. Do not publish the raw clones.
/better-options/

# Server runtime scratch
/.export/
/.agent-mesh/
/.audit/
/.ghidra-projects/
/.fakepdb-scripts/
/.docker-data/
/.index-cache/
/.cache/

# The whole content library lives in db/skills.db (SQLite + FTS5).
# These directories are the pre-DB source of truth; the writer in
# scripts/build-db.mjs reads them when regenerating the DB. They are
# NOT shipped in the repo — see RELEASE.md for how to fetch them if
# you want to rebuild the DB locally.
/skills/
/plugins/
/agents/
/subagents/
/prompts/

# SQLite side-car files (WAL + SHM). The main .db is tracked.
db/*.db-wal
db/*.db-shm
db/skills-full.db
