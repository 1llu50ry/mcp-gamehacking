# Everything the Docker build does not need. Smaller build context
# = faster uploads to the daemon + less fingerprinting churn.

# ---- always-exclude ----
.git/
.github/
.claude/
.vscode/
.idea/
node_modules/
dist/
coverage/
.nyc_output/
*.log
npm-debug.log*

# ---- editor cruft / OS metadata ----
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ---- repo-local scratch (runtime writes these) ----
.export/
.agent-mesh/
.audit/
.index-cache/
.cache/
.docker-data/
.ghidra-projects/

# ---- upstream mirrors + vendored binaries not needed at runtime ----
better-options/
tools/vendor/
tools/launchers/

# ---- docs / examples: shipped in the npm tarball, not the image ----
docs/
examples/
deploy/
CHANGELOG.md
ROADMAP.md
README-*.md
plugins-side/

# ---- content library (DB-only in the image) ----
# The 5 raw directories are the DB's source material; the image
# only needs db/skills.db at runtime.
skills/
plugins/
agents/
subagents/
prompts/

# ---- tests / tooling ----
tests/
.devcontainer/
*.test.mjs
*.tsbuildinfo
