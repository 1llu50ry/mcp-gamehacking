{
  "name": "mcp-reverse",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "forwardPorts": [7777],
  "portsAttributes": {
    "7777": {
      "label": "MCP HTTP",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm ci || npm install && npx tsc",
  "postAttachCommand": {
    "server": "echo '→ run: node dist/index.js (stdio) or MCP_TRANSPORT=http node dist/index.js (HTTP :7777)'"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "github.vscode-github-actions",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "typescript.tsdk": "node_modules/typescript/lib",
        "files.eol": "\n"
      }
    }
  },
  "remoteUser": "node",
  "mounts": [
    "source=mcp-reverse-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ]
}
